# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает.
# Любой OpenAI-совместимый провайдер: меняются только адрес, ключ и модель.

MAIL_AGENT_LLM_BACKEND=openai
MAIL_AGENT_LLM_BASE_URL=https://api.openai.com/v1
MAIL_AGENT_LLM_API_KEY=
MAIL_AGENT_LLM_MODEL=gpt-4o-mini

# Примеры других провайдеров:
# OpenRouter: MAIL_AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1   MAIL_AGENT_LLM_MODEL=openai/gpt-4o-mini
# DeepSeek:   MAIL_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1   MAIL_AGENT_LLM_MODEL=deepseek-chat
# Groq:       MAIL_AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1 MAIL_AGENT_LLM_MODEL=llama-3.3-70b-versatile

# Пусто — не передавать temperature (для моделей, которые её не принимают).
MAIL_AGENT_LLM_TEMPERATURE=0
MAIL_AGENT_LLM_TIMEOUT=120
MAIL_AGENT_LLM_MAX_RETRIES=3

# Офлайн-вариант: локальная Ollama
# MAIL_AGENT_LLM_BACKEND=ollama
# MAIL_AGENT_LLM_MODEL=qwen2.5:7b
